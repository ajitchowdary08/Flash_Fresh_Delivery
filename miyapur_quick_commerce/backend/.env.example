# ============================================================================
# Miyapur Quick Commerce — Backend Environment Configuration
# Copy this file to backend/.env and fill in your real credentials.
# NEVER commit backend/.env to git. It is gitignored.
# ============================================================================

# --- App environment --------------------------------------------------------
ENVIRONMENT=development                # development | production
PROJECT_NAME="Flash Fresh & Sunday Meat Quick Commerce"

# --- Security & JWT ---------------------------------------------------------
# In production, set a unique random string of at least 32 characters.
# The app REFUSES TO BOOT in production if this is missing or weak.
JWT_SECRET_KEY=dev_insecure_jwt_secret_change_me_in_production_min_32_chars_long

# When true (only honored in development), the OTP 123456 is accepted as a
# test backdoor. Always false in production regardless of this value.
DEV_OTP_BYPASS=true

# Comma-separated CORS origins. Use your real frontend origin(s) in production.
CORS_ORIGINS=*

# --- Database & Redis -------------------------------------------------------
DATABASE_URL=sqlite:///./quick_commerce.db
REDIS_URL=redis://localhost:6379/0

# --- SMS Gateway (Fast2SMS / MSG91 / Twilio) --------------------------------
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=

# --- Google Maps Platform ---------------------------------------------------
# Required for Places Autocomplete, Geocoding, Reverse-Geocoding and the
# customer-app GoogleMap widget. The SAME key must be set in:
#   customer_app/android/app/src/main/AndroidManifest.xml  (com.google.android.geo.API_KEY)
#   customer_app/ios/Runner/Info.plist                      (GoogleMapsApiKey)
GOOGLE_MAPS_API_KEY=AIzaSyBNnGocMHDAzc9cV61uTeHFpbKiogeIWas

# --- Central Dark Store Hub Geofence ----------------------------------------
# Exact Google Maps pin: https://maps.app.goo.gl/5fc6a8ZMgjfttUiB9
# The 10 KM delivery radius is enforced server-side on every order, every saved
# address, and every GPS-detected location. Coordinates outside the radius are
# rejected with HTTP 400 "Delivery not available".
STORE_LATITUDE=17.495101
STORE_LONGITUDE=78.367535
MAX_DELIVERY_RADIUS_KM=10.0
STORE_NAME="Central Dark Store Hub"
STORE_ADDRESS="Beside Metro Pillar 84, Miyapur, Hyderabad, Telangana 500049"

# --- Cashfree Payment Gateway (Sandbox / Live) -----------------------------
# Sandbox test credentials are pre-filled for instant testing.
# In production, replace with live credentials from the Cashfree dashboard.
CASHFREE_ENV=sandbox                     # sandbox | production
CASHFREE_APP_ID=TEST11361500854188d61c28cdc37e6d00516311
CASHFREE_SECRET_KEY=cfsk_ma_test_80e826f86581fa4e7d6ea9af24c4da2a_ba79c20a
# Register this webhook URL in the Cashfree dashboard (HTTPS only):
#   https://your-backend.example.com/api/v1/payments/cashfree/webhook
# In production, set CASHFREE_WEBHOOK_SECRET to the secret from the dashboard,
# otherwise the webhook endpoint refuses to accept any event (fail-closed).
CASHFREE_WEBHOOK_SECRET=
